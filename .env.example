# ═══════════════════════════════════════════════════════════
# AdminDashboard — Variáveis de ambiente
# ═══════════════════════════════════════════════════════════
# Copia este ficheiro para .env.prod e preenche os valores reais.
# NUNCA faças commit do .env.prod para o git.
#
# Para gerar secrets fortes:
#   bash scripts/generate-secrets.sh

# ──────────────────────────────────────────────────────────
# Ambiente
# ──────────────────────────────────────────────────────────
APP_ENV=production

# ──────────────────────────────────────────────────────────
# Portas (no host) — usadas só por localhost via Cloudflare Tunnel
# ──────────────────────────────────────────────────────────
API_PORT=5001
WEB_PORT=3003

# ──────────────────────────────────────────────────────────
# PostgreSQL (existente, partilhado)
# ──────────────────────────────────────────────────────────
# postgres-server está na rede melresin-net (à qual o admin-api se junta)
POSTGRES_HOST=postgres-server
POSTGRES_PORT=5432
POSTGRES_DB=admindashboard_db
POSTGRES_USER=admindashboard_app
# Gera com: openssl rand -base64 32
POSTGRES_PASSWORD=ALTERA_PARA_PASSWORD_FORTE

# ──────────────────────────────────────────────────────────
# JWT (autenticação)
# ──────────────────────────────────────────────────────────
# Gera com: openssl rand -base64 64
JWT_SECRET=ALTERA_PARA_SECRET_LONGO_E_ALEATORIO
JWT_ISSUER=AdminDashboard
JWT_AUDIENCE=AdminDashboard
# Validade do token em minutos (1440 = 24h)
JWT_EXPIRY_MINUTES=1440

# ──────────────────────────────────────────────────────────
# NextAuth (frontend)
# ──────────────────────────────────────────────────────────
NEXTAUTH_URL=https://admin.raguiar.pt
# Gera com: openssl rand -base64 64
NEXTAUTH_SECRET=ALTERA_PARA_SECRET_LONGO_E_ALEATORIO

# ──────────────────────────────────────────────────────────
# Binance API
# ──────────────────────────────────────────────────────────
# Cria as keys em https://www.binance.com/en/my/settings/api-management
# CRÍTICO: ativa SÓ "Enable Reading". NUNCA "Enable Withdrawals".
# Restringe por IP do servidor: descobre com `curl ifconfig.me`
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ──────────────────────────────────────────────────────────
# Anthropic (Claude API)
# ──────────────────────────────────────────────────────────
# Obtém em https://console.anthropic.com/settings/keys
# Custo esperado para uso pessoal: ~5-15€/mês
ANTHROPIC_API_KEY=
# Modelo a usar (ver https://docs.anthropic.com para nomes atualizados)
ANTHROPIC_MODEL=claude-opus-4-7

# ──────────────────────────────────────────────────────────
# CORS (origens permitidas pela API)
# ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://admin.raguiar.pt,http://localhost:3003
